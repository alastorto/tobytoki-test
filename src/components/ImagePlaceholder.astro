---
interface Props {
  label: string;
  aspect?: 'hero' | 'portrait' | 'landscape' | 'square' | 'tall' | 'wide-hero';
  framed?: boolean;
  priority?: boolean;
  class?: string;
}

const {
  label,
  aspect = 'portrait',
  framed = true,
  priority = false,
  class: className = '',
} = Astro.props;

const loading = priority ? 'eager' : 'lazy';
---

<figure
  class:list={['ph-wrap', className]}
  data-priority={priority ? 'true' : 'false'}
>
  <div class:list={['ph', framed && 'ph-frame']} data-aspect={aspect}>
    <div class="ph-inner" role="img" aria-label={label} data-loading={loading}>
      <span class="ph-label">{label}</span>
    </div>
  </div>
</figure>
