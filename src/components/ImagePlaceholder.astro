---
interface Props {
  label: string;
  /** Kept for call-site compatibility; all images render 2:3 (w:h). */
  aspect?: string;
  framed?: boolean;
  priority?: boolean;
  class?: string;
}

const {
  label,
  framed = true,
  priority = false,
  class: className = '',
} = Astro.props;

const loading = priority ? 'eager' : 'lazy';
---

<figure
  class:list={['ph-wrap', className]}
  data-priority={priority ? 'true' : 'false'}
>
  <div class:list={['ph', framed && 'ph-frame']} data-aspect="2x3">
    <div class="ph-inner" role="img" aria-label={label} data-loading={loading}>
      <span class="ph-label">{label}</span>
    </div>
  </div>
</figure>
