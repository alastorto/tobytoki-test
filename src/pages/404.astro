---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import { pageHref } from '../i18n/utils';

const locale = 'zh' as const;
const copy = t(locale);
---

<BaseLayout
  locale={locale}
  title={copy.notFound.metaTitle}
  description={copy.notFound.body}
  path="404"
  current=""
>
  <section class="page-hero container center">
    <h1>{copy.notFound.h1}</h1>
    <p class="lede" style="margin: 1rem auto;">{copy.notFound.body}</p>
    <a class="link-caps" href={pageHref(locale, 'home')}>{copy.notFound.home}</a>
    <p class="mt-2">
      <a class="link-caps" href="/en">{t('en').notFound.home} (EN)</a>
    </p>
  </section>
</BaseLayout>
