---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<BaseLayout
  locale={locale}
  title={copy.work.metaTitle}
  description={copy.work.metaDescription}
  path="work"
  current="work"
>
  <section class="page-hero container">
    <Breadcrumb locale={locale} items={[{ label: copy.work.h1 }]} />
    <h1>{copy.work.h1}</h1>
    <p class="lede mt-1">{copy.work.lead}</p>
  </section>
  <section class="section-tight">
    <div class="container">
      <PortfolioGrid locale={locale} filterable />
    </div>
  </section>
  <CtaBand locale={locale} />
</BaseLayout>
