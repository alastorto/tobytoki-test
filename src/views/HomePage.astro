---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionRule from '../components/SectionRule.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import StripCarousel from '../components/StripCarousel.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import JournalPreview from '../components/JournalPreview.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';
import { pageHref } from '../i18n/utils';
import { getJournalPosts } from '../lib/journal';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const posts = (await getJournalPosts(locale)).slice(0, 3);
const faqPreviewIds = ['fp-age', 'fp-duration', 'ba-vs-fp', 'bk-lead', 'bk-info', 'ba-styles'];
---

<BaseLayout
  locale={locale}
  title={copy.home.metaTitle}
  description={copy.home.metaDescription}
  path=""
  current="home"
>
  <HeroCarousel
    label={copy.home.heroCarouselLabel}
    slides={[...copy.home.heroSlides]}
  />

  <section class="section section-center">
    <div class="container">
      <h1 class="headline-mix headline-xl">
        {copy.home.dreamSans}
        <br />
        <span class="accent">{copy.home.dreamSerif}</span>
      </h1>
      <p class="mt-2">
        <a class="link-caps" href={pageHref(locale, 'work')}>{copy.home.dreamCta}</a>
      </p>
    </div>
  </section>

  <SectionRule />

  <section class="section section-center promise-block">
    <div class="container">
      <h2 class="headline-mix headline-lg promise-line">
        {copy.home.promiseSans}
        <br />
        <span class="accent">{copy.home.promiseSerif}</span>
        {' '}
        {copy.home.promiseAnd}
        {' '}
        <span class="accent">{copy.home.promiseEnd}</span>
      </h2>
    </div>
  </section>

  <SectionRule />

  <section class="section section-center">
    <div class="container">
      <h2 class="headline-mix headline-lg">
        {copy.home.heritageSans}
        <br />
        <span class="accent">{copy.home.heritageSerif}</span>
        {' '}
        {copy.home.heritageTail}
      </h2>
      <p class="section-lede">{copy.home.heritageBody}</p>
      <p class="mt-2">
        <a class="link-caps" href={pageHref(locale, 'about')}>{copy.home.heritageCta}</a>
      </p>
      <div class="heritage-grid">
        {
          copy.home.heritageCaps.map((item) => (
            <figure>
              <ImagePlaceholder label={item.label} aspect="square" />
              <figcaption class="frame-caption">{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container service-trio">
      <article>
        <ImagePlaceholder label="FACE PAINTING — MAIN" aspect="portrait" />
        <p class="index-label">01 / Face Painting</p>
        <h2 class="headline-mix service-title">
          {copy.home.faceTitle}
          <span class="accent"> · {copy.home.faceVisual}</span>
        </h2>
        <p>{copy.home.faceBody}</p>
        <a class="link-caps" href={pageHref(locale, 'face-painting')}>{copy.home.faceCta}</a>
      </article>
      <article>
        <ImagePlaceholder label="BALLOON ART — MAIN" aspect="portrait" />
        <p class="index-label">02 / Balloon Art</p>
        <h2 class="headline-mix service-title">{copy.home.balloonTitle}</h2>
        <p>{copy.home.balloonBody}</p>
        <a class="link-caps" href={pageHref(locale, 'balloon-twisting')}>{copy.home.balloonCta}</a>
      </article>
      <article>
        <ImagePlaceholder label="PHOTOGRAPHY — MAIN" aspect="portrait" />
        <p class="index-label">03 / Photography</p>
        <h2 class="headline-mix service-title">{copy.home.photoTitle}</h2>
        <p>{copy.home.photoBody}</p>
        <a class="link-caps" href={pageHref(locale, 'photography')}>{copy.home.photoCta}</a>
      </article>
    </div>
  </section>

  <StripCarousel
    title={copy.home.stripTitle}
    accent={copy.home.stripAccent}
    lead={copy.home.stripLead}
    items={[...copy.home.stripItems]}
  />

  <section class="section">
    <div class="container">
      <div class="center">
        <h2 class="headline-mix headline-md">{copy.home.selectedWork}</h2>
      </div>
      <div class="mt-2">
        <PortfolioGrid locale={locale} limit={8} />
      </div>
      <p class="center mt-2">
        <a class="link-caps" href={pageHref(locale, 'work')}>{copy.home.viewWork}</a>
      </p>
    </div>
  </section>

  <SectionRule />

  <section class="section">
    <div class="container">
      <div class="center">
        <h2 class="headline-mix headline-md">{copy.home.journalTitle}</h2>
        <p class="section-lede">{copy.home.journalLead}</p>
      </div>
      <div class="mt-2">
        <JournalPreview locale={locale} posts={posts} />
      </div>
      <p class="center mt-2">
        <a class="link-caps" href={pageHref(locale, 'journal')}>{copy.home.viewJournal}</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center" style="margin-bottom: 1.5rem;">
        <h2 class="headline-mix headline-md">{copy.home.faqTitle}</h2>
      </div>
      <FaqList locale={locale} ids={faqPreviewIds} />
      <p class="center mt-2">
        <a class="link-caps" href={pageHref(locale, 'faq')}>{copy.home.viewFaq}</a>
      </p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
