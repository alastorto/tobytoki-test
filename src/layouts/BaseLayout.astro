---
import Seo from '../components/Seo.astro';
import StructuredData from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeToHtmlLang, siteConfig, type Locale } from '../data/site';
import { absoluteUrl } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  current?: string;
  ogType?: 'website' | 'article';
  schemas?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  path = '',
  current = '',
  ogType = 'website',
  schemas = [],
} = Astro.props;

const htmlLang = localeToHtmlLang[locale];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  inLanguage: [localeToHtmlLang.zh, localeToHtmlLang.en],
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Toby',
  url: absoluteUrl(locale === 'en' ? '/en/about' : '/about'),
  jobTitle: 'Face Painter, Balloon Artist, Photographer',
  worksFor: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
};

const allSchemas = [websiteSchema, personSchema, ...(Array.isArray(schemas) ? schemas : [schemas])].filter(
  Boolean,
);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@400;500;600&family=Public+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <Seo locale={locale} title={title} description={description} path={path} ogType={ogType} />
    <StructuredData data={allSchemas} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header locale={locale} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
